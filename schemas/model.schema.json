{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.neat.sima.ai/model-registry/model.schema.json",
  "title": "SiMa Neat Model Registry model.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "display_name",
    "description",
    "model_type",
    "tasks",
    "model_family",
    "license",
    "compilation",
    "build_profiles"
  ],
  "properties": {
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "model_type": {
      "$ref": "#/$defs/taxonomyId"
    },
    "tasks": {
      "$ref": "#/$defs/taxonomyIdSet"
    },
    "license": {
      "$ref": "#/$defs/license"
    },
    "upstream": {
      "$ref": "#/$defs/upstream"
    },
    "pipeline": {
      "type": "array",
      "minItems": 2,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component"
            ],
            "properties": {
              "component": {
                "$ref": "#/$defs/id"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cpu"
            ],
            "properties": {
              "cpu": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "model_family": {
      "$ref": "#/$defs/taxonomyId"
    },
    "build_on_demand": {
      "type": "boolean"
    },
    "conversion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "compilation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "source",
        "components"
      ],
      "properties": {
        "format": {
          "enum": [
            "onnx",
            "huggingface"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "runtime_entrypoint": {
          "enum": [
            "generate",
            "transcribe"
          ]
        }
      }
    },
    "datasets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/datasetRef"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source"
            ],
            "properties": {
              "source": {
                "$ref": "#/$defs/source"
              }
            }
          }
        ]
      }
    },
    "build_profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/buildProfile"
      }
    },
    "numerical_fidelity": {
      "$ref": "#/$defs/fidelityEntry"
    },
    "accuracy": {
      "$ref": "#/$defs/devkitAccuracy"
    },
    "performance": {
      "$ref": "#/$defs/benchmarkEntry"
    },
    "reference_metrics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/publishedMetrics"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "taxonomyId": {
      "$ref": "#/$defs/id"
    },
    "taxonomyIdSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/taxonomyId"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdx",
        "customer_redistribution",
        "attribution"
      ],
      "properties": {
        "spdx": {
          "type": "string",
          "minLength": 1
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "customer_redistribution": {
          "const": "prohibited"
        }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "model_card": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "derived_from": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "sourceUri": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?:hf://(?:models|datasets|spaces)/[^@/]+/[^@/]+@[a-f0-9]{40}/.+|https://.+)$"
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "main_file",
            "files"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^[^/@]+/[^/@]+$"
            },
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "files": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "$ref": "#/$defs/relativePath"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "sha256",
                  "size_bytes"
                ],
                "properties": {
                  "uri": {
                    "$ref": "#/$defs/sourceUri"
                  },
                  "sha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "size_bytes": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "media_type": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "main_file": {
              "$ref": "#/$defs/relativePath"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "uri",
            "sha256",
            "size_bytes"
          ],
          "properties": {
            "type": {
              "const": "file"
            },
            "uri": {
              "$ref": "#/$defs/sourceUri"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1
            },
            "media_type": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "datasetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "variant",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "variant": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "buildComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameters"
      ],
      "properties": {
        "runner_class": {
          "enum": [
            "default",
            "expensive",
            "most-expensive"
          ]
        },
        "parameters": {
          "type": "object"
        },
        "status": {
          "enum": [
            "supported",
            "unsupported"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unsupported"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "buildProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "components"
      ],
      "properties": {
        "runner_class": {
          "enum": [
            "default",
            "expensive",
            "most-expensive"
          ]
        },
        "calibration_dataset": {
          "$ref": "#/$defs/id"
        },
        "components": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/buildComponent"
          }
        }
      }
    },
    "stageBuildProfiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "datasetId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "fidelityEntry": {
      "description": "Numerical comparison of compiled outputs against the source model, computed by scripts/compile.py.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "dataset",
        "selection",
        "outputs"
      ],
      "properties": {
        "build_profiles": {
          "$ref": "#/$defs/stageBuildProfiles"
        },
        "status": {
          "enum": [
            "diagnostic",
            "provisional",
            "ready"
          ]
        },
        "dataset": {
          "$ref": "#/$defs/id"
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "seed",
            "offset",
            "samples"
          ],
          "properties": {
            "method": {
              "const": "seeded_random_without_replacement"
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            },
            "offset": {
              "type": "integer",
              "minimum": 0
            },
            "samples": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "devkitAccuracy": {
      "description": "Task accuracy measured by the model's scripts/accuracy.py with its compiled MPKs on a DevKit.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "dataset",
        "required_metrics"
      ],
      "anyOf": [
        {
          "required": [
            "metrics"
          ]
        },
        {
          "required": [
            "required_metrics"
          ]
        }
      ],
      "properties": {
        "build_profiles": {
          "$ref": "#/$defs/stageBuildProfiles"
        },
        "status": {
          "enum": [
            "ready",
            "provisional"
          ]
        },
        "dataset": {
          "$ref": "#/$defs/id"
        },
        "metrics": {
          "$ref": "#/$defs/accuracyMetricNames"
        },
        "required_metrics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^model\\.accuracy\\.[a-z][a-z0-9_]*$"
          }
        }
      }
    },
    "publishedMetrics": {
      "description": "Scores the source model's authors published for these weights, copied from a pinned page.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "dataset",
        "conditions",
        "metrics"
      ],
      "properties": {
        "source": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "dataset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "split"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/datasetId"
            },
            "split": {
              "$ref": "#/$defs/datasetId"
            }
          }
        },
        "conditions": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "metrics": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "accuracyMetricNames": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "benchmarkEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_metrics"
      ],
      "properties": {
        "build_profiles": {
          "$ref": "#/$defs/stageBuildProfiles"
        },
        "status": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        },
        "required_metrics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "pattern": "^pending"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "reason"
                ]
              },
              {
                "required": [
                  "note"
                ]
              }
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "model_type": {
            "const": "vision"
          },
          "compilation": {
            "properties": {
              "format": {
                "const": "onnx"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "performance"
        ]
      }
    }
  ]
}
