{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neat.sima.ai/schemas/model-report.schema.json",
  "title": "SiMa Neat model report",
  "description": "A model's whole-model performance or accuracy, written by tools/model_report from Neat Core's results. tools/model_report/metrics.json names each metric's unit and direction.",
  "type": "object",
  "required": ["schema", "schema_version", "stage", "runtime", "metrics"],
  "properties": {
    "schema": {"const": "sima.model-report"},
    "schema_version": {"const": 1},
    "stage": {"enum": ["performance", "accuracy"]},
    "runtime": {
      "type": "object",
      "required": ["pyneat", "build"],
      "properties": {
        "pyneat": {"type": "string", "minLength": 1},
        "build": {"type": "object"}
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
      "additionalProperties": {"type": "number"}
    }
  },
  "oneOf": [
    {
      "properties": {
        "stage": {"const": "performance"},
        "schema": true, "schema_version": true, "runtime": true, "metrics": true,
        "workload": {"type": "string", "minLength": 1},
        "telemetry": {"type": "object"},
        "components": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
          "additionalProperties": {
            "type": "object",
            "required": ["execution_plan", "layer_stats"],
            "properties": {
              "execution_plan": {"type": "object"},
              "layer_stats": {"type": "array", "items": {"type": "object"}}
            },
            "additionalProperties": false
          }
        }
      },
      "required": ["workload", "telemetry", "components"],
      "additionalProperties": false
    },
    {
      "properties": {
        "stage": {"const": "accuracy"},
        "schema": true, "schema_version": true, "runtime": true,
        "metrics": {"additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
        "dataset": {
          "type": "object",
          "required": ["split", "evaluated_samples", "available_samples"],
          "properties": {
            "split": {"type": "string", "minLength": 1},
            "evaluated_samples": {"type": "integer", "minimum": 1},
            "available_samples": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        "details": {"type": "object"}
      },
      "required": ["dataset", "details"],
      "additionalProperties": false
    }
  ]
}
